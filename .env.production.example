# ──────────────────────────────────────────────────────────────────────────────
# Westbridge ERP Backend — Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill in real values before deploying.
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://westbridge:CHANGE_ME@postgres:5432/westbridge
SESSION_SECRET=generate-a-64-char-random-string
CSRF_SECRET=generate-a-64-char-random-string
ENCRYPTION_KEY=generate-a-32-byte-hex-string

# ─── Docker Compose Passwords ────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://default:CHANGE_ME@redis:6379

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.westbridge.gy
NEXT_PUBLIC_APP_URL=https://app.westbridge.gy

# ─── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SAME_SITE=none

# ─── Payments (2Checkout / Verifone) ─────────────────────────────────────────
TWOCHECKOUT_MERCHANT_CODE=
TWOCHECKOUT_SECRET_KEY=
TWOCHECKOUT_TEST_MODE=false

# ─── Email (Resend or SMTP) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Westbridge <noreply@westbridge.gy>
# OR use SMTP instead of Resend:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Data Engine (ERPNext) ───────────────────────────────────────────────────
ERPNEXT_URL=https://yoursite.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
LOG_LEVEL=info
