# ──────────────────────────────────────────────────────────────────────────────
# Westbridge ERP Backend — Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file and fill in real values before deploying.
# For Fly.io: use `fly secrets set KEY=VALUE` instead of a .env file.
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database — RLS-enforced runtime role ─────────────────────────────────────
# Application queries connect as `westbridge_app`, which is bound by Row-Level
# Security policies (see prisma/migrations/*_rls). Provision the role with
# scripts/provision-rls-role.sh against your Fly Postgres app, store the
# generated password in Fly secrets, and rebuild the URL here.
DATABASE_URL=postgresql://westbridge_app:PASSWORD_FROM_PROVISION_SCRIPT@host:5432/westbridge?schema=public

# Migrations and DDL run as the schema-owning role (the URL Fly originally
# attached). Set this to the role created by `fly postgres attach`. Prisma's
# migrate/db push commands automatically use this via `directUrl` in
# prisma/schema.prisma; runtime queries do not.
MIGRATION_DATABASE_URL=postgresql://owner:password@host:5432/westbridge?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── Security (REQUIRED — server refuses to start with defaults) ──────────────
SESSION_SECRET=   # openssl rand -hex 32
CSRF_SECRET=      # openssl rand -hex 32
ENCRYPTION_KEY=   # openssl rand -hex 32

# ── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.westbridgetoday.com
NEXT_PUBLIC_APP_URL=https://app.westbridgetoday.com

# ── ERPNext Cloud (https://erpnext.com) ─────────────────────────────────────
# IMPORTANT: Generate SEPARATE credentials for production.
# Do NOT reuse development API keys. Create a new key pair at:
# Frappe Cloud → Settings → API Access → Generate Keys
ERPNEXT_URL=https://yoursite.erpnext.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=Westbridge <noreply@westbridgetoday.com>

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── Billing (Paddle — Merchant of Record) ────────────────────────────────
PADDLE_API_KEY=              # Paddle API key (from Paddle dashboard > Developer Tools)
PADDLE_WEBHOOK_SECRET=       # Paddle webhook secret (from Paddle dashboard > Notifications)
PADDLE_SANDBOX=false         # "true" for sandbox, "false" for live
PADDLE_CLIENT_TOKEN=         # Paddle client-side token (for Paddle.js)
PADDLE_PRICE_SOLO=           # Paddle price ID for Solo plan
PADDLE_PRICE_STARTER=        # Paddle price ID for Starter plan
PADDLE_PRICE_BUSINESS=       # Paddle price ID for Business plan
PADDLE_PRICE_ENTERPRISE=     # Paddle price ID for Enterprise plan

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
POSTHOG_API_KEY=
LOG_LEVEL=info

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SAME_SITE=none
