// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String    @id @default(cuid())
  email            String    @unique
  companyName      String    @map("company_name")
  erpnextCompany   String?   @map("erpnext_company") // ERPNext Company name for row-level scoping
  plan             String    // Starter | Growth | Business
  status           String    @default("pending") // pending | active | past_due | canceled
  currency         String    @default("GYD")     // Default currency (Caribbean-first)
  country          String    @default("GY")      // ISO 3166-1 alpha-2
  timezone         String    @default("America/Guyana")
  paymentTransactionId  String?   @map("payment_transaction_id")  // PowerTranz transaction identifier
  paymentRRN            String?   @map("payment_rrn")             // PowerTranz Retrieval Reference Number
  modulesSelected  String[]  @map("modules_selected") // module ids
  trialEndsAt      DateTime? @map("trial_ends_at")
  trialAiLimit     Int       @default(10) @map("trial_ai_limit")
  version          Int       @default(1)          // Optimistic concurrency control
  deletedAt        DateTime? @map("deleted_at")   // Soft delete
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  users              User[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  inviteTokens       InviteToken[]
  webhookEndpoints   WebhookEndpoint[]
  ssoConfig          SsoConfig?
  billingInvoices    BillingInvoice[]
  cortexEvents       CortexEvent[]
  cortexConversations CortexConversation[]
  cortexExecutions   CortexExecutionLog[]
  cortexApprovals    CortexApprovalRequest[]
  cortexMemory       CortexMemory[]
  cortexFeedback     CortexFeedback[]

  @@index([createdAt])
  @@index([deletedAt])
  @@map("accounts")
}

model User {
  id                   String    @id @default(cuid())
  accountId            String    @map("account_id")
  email                String    /// @pii - Personal Identifiable Information
  name                 String?   /// @pii - Personal Identifiable Information
  role                 String    // "owner" | "admin" | "manager" | "member" | "viewer"
  passwordHash         String?   @map("password_hash")
  status               String    @default("active") // active | suspended | invited
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  lastFailedLogin      DateTime? @map("last_failed_login")
  passwordChangedAt    DateTime? @map("password_changed_at")
  version              Int       @default(1)          // Optimistic concurrency control
  deletedAt            DateTime? @map("deleted_at")   // Soft delete
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@unique([accountId, email])
  @@index([accountId])
  @@index([accountId, deletedAt])
  @@index([accountId, createdAt])
  @@index([email])
  @@map("users")
}

model Session {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  token       String   @unique // SHA-256 hash of the raw token
  erpnextSid  String?  @map("erpnext_sid") // ERPNext session for API proxy
  ipAddress   String?  @map("ip_address") /// @pii - Personal Identifiable Information
  userAgent   String?  @map("user_agent") /// @pii - Personal Identifiable Information
  fingerprint String?  // hash of User-Agent for session binding
  expiresAt   DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@index([userId, expiresAt])  // Composite: session cleanup + concurrent session queries
  @@map("sessions")
}

model Subscription {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  planId                String    @map("plan_id") // Starter | Growth | Business etc.
  status                String    // active | canceled | past_due | trialing
  currentPeriodStart    DateTime  @map("current_period_start")
  currentPeriodEnd      DateTime  @map("current_period_end")
  paymentSubscriptionId String?   @map("payment_subscription_id") // PowerTranz subscription reference
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([paymentSubscriptionId])
  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  accountId  String   @map("account_id")
  userId     String?  @map("user_id")
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address") /// @pii - Personal Identifiable Information
  userAgent  String?  @map("user_agent") /// @pii - Personal Identifiable Information
  metadata   Json?
  severity   String   @default("info") // info, warn, critical
  outcome    String   @default("success") // success, failure, error

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, timestamp])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([severity, timestamp])
  @@map("audit_logs")
}

model ApiKey {
  id        String    @id @default(cuid())
  accountId String    @map("account_id")
  keyHash   String    @map("key_hash") // hash of the raw key
  prefix    String    // first few chars for display (e.g. wb_xxxx)
  label     String?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([accountId])
  @@map("api_keys")
}

model InviteToken {
  id        String    @id @default(cuid())
  accountId String    @map("account_id")
  email     String    /// @pii - Personal Identifiable Information
  role      String    @default("member") // owner | admin | manager | member | viewer
  tokenHash String    @unique @map("token_hash") // SHA-256 of raw token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, email])
  @@index([tokenHash])
  @@index([accountId])
  @@map("invite_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // SHA-256 of raw token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ─── Lead Capture (Blocker #12) ─────────────────────────────────────────────
model Lead {
  id        String   @id @default(cuid())
  type      String   // "demo" | "newsletter"
  email     String   /// @pii
  name      String?  /// @pii
  company   String?
  phone     String?  /// @pii
  country   String?
  source    String?  // referrer, campaign, etc.
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([email])
  @@map("leads")
}

// ─── SSO Configuration (Blocker #11) ────────────────────────────────────────
model SsoConfig {
  id             String   @id @default(cuid())
  accountId      String   @unique @map("account_id")
  provider       String   @default("oidc") // "oidc" | "saml"
  issuerUrl      String   @map("issuer_url")
  clientId       String   @map("client_id")
  clientSecret   String   @map("client_secret") // encrypted
  allowedDomains String[] @map("allowed_domains")
  autoProvision  Boolean  @default(true) @map("auto_provision")
  defaultRole    String   @default("member") @map("default_role")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sso_configs")
}

// ─── Notification Preferences (Blocker #8) ──────────────────────────────────
model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String  @unique @map("user_id")
  emailInvoices    Boolean @default(true) @map("email_invoices")
  emailReports     Boolean @default(true) @map("email_reports")
  emailSecurityAlerts Boolean @default(true) @map("email_security_alerts")
  emailProductUpdates Boolean @default(false) @map("email_product_updates")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ─── TOTP 2FA (Blocker #10) ─────────────────────────────────────────────────
model TotpSecret {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  secret    String   // encrypted TOTP secret
  verified  Boolean  @default(false)
  backupCodes String[] @map("backup_codes") // hashed backup codes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("totp_secrets")
}

// ─── Billing Invoices (Blocker #4) ──────────────────────────────────────────
model BillingInvoice {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  status        String   @default("paid") // paid | pending | failed | refunded
  planId        String   @map("plan_id")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  transactionId String?  @map("transaction_id") // PowerTranz reference
  rrn           String?  // Retrieval Reference Number
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([accountId, status])  // Billing queries filtered by payment status
  @@map("billing_invoices")
}

model WebhookEndpoint {
  id                  String    @id @default(cuid())
  accountId           String    @map("account_id")
  url                 String
  events              String[]  // event types this endpoint subscribes to
  secret              String    // HMAC signing secret; stored encrypted at rest (see lib/encryption)
  enabled             Boolean   @default(true)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledAt          DateTime? @map("disabled_at") // set when circuit breaker trips; survives restarts
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("webhook_endpoints")
}

// ─── CORTEX (AI Kernel) ───────────────────────────────────────────────────────
//
// Phase 1 of the AI-Native ERP overhaul. The Cortex layers an event-driven
// agent kernel on top of the existing Prisma + BullMQ stack. All tables are
// scoped by accountId (the existing tenant boundary). The legacy /api/ai/chat
// route and src/lib/ai/* helpers continue to function in parallel — Cortex
// adds persistent conversations, execution traces, an approval queue, and a
// learning memory layer that the legacy chat does not provide.

/// Immutable event log. Every business mutation (invoice.created,
/// payment.received, document.uploaded, ...) writes one row here and queues a
/// CortexEventJob for the orchestrator to handle.
model CortexEvent {
  id          String    @id @default(cuid())
  accountId   String    @map("account_id")
  eventType   String    @map("event_type")  // e.g. "invoice.created"
  source      String                          // "user.action" | "api.webhook" | "email.inbound" | "agent.action" | "system.cron"
  data        Json
  userId      String?   @map("user_id")
  agentId     String?   @map("agent_id")
  traceId     String    @map("trace_id")
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  processedBy String?   @map("processed_by")  // agent id that handled it
  result      Json?
  createdAt   DateTime  @default(now())       @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, eventType, createdAt])
  @@index([accountId, processed])
  @@index([traceId])
  @@map("cortex_events")
}

/// Persistent multi-turn conversations between users and the Bridge AI
/// (conversation agent). Distinct from the Redis-backed history used by the
/// legacy /api/ai/chat — these survive restarts, support cross-device resume,
/// and feed the AI activity log.
model CortexConversation {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  userId       String   @map("user_id")
  title        String?
  /// Stored as Json so we can serialize Anthropic.MessageParam[] with tool
  /// blocks intact across restarts. Capped to the last N turns by application
  /// logic to keep rows reasonable.
  messages     Json     @default("[]")
  lastAgentId  String?  @map("last_agent_id")
  lastTraceId  String?  @map("last_trace_id")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, userId, updatedAt])
  @@index([accountId, archived])
  @@map("cortex_conversations")
}

/// One row per agent run. Captures the inputs, the model + token usage, the
/// number of tool calls, the latency, and the outcome so a human can audit
/// what the AI did. Indexed by trace ID so a chat reply can be linked to the
/// underlying execution.
model CortexExecutionLog {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  agentId         String   @map("agent_id")
  traceId         String   @map("trace_id")
  triggerEventId  String?  @map("trigger_event_id")
  status          String                      // "success" | "failed" | "needs_approval" | "timeout"
  model           String                      // e.g. "claude-opus-4-6"
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  costUsd         Float    @map("cost_usd")
  latencyMs       Int      @map("latency_ms")
  iterations      Int                         // agentic loop rounds
  toolCallCount   Int      @map("tool_call_count")
  toolCallErrors  Int      @map("tool_call_errors")
  output          String?  @db.Text           // textual reply (truncated)
  errorMessage    String?  @map("error_message") @db.Text
  createdAt       DateTime @default(now())    @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, agentId, createdAt])
  @@index([traceId])
  @@map("cortex_execution_logs")
}

/// Pending actions the AI wants to take but cannot execute autonomously
/// because they exceed the agent's autonomy level or financial limit. A human
/// reviews and either approves (the action is then executed) or rejects.
model CortexApprovalRequest {
  id               String    @id @default(cuid())
  accountId        String    @map("account_id")
  title            String
  description      String    @db.Text
  approvalType     String    @map("approval_type")    // e.g. "payment.execute" | "vendor.create" | "invoice.large"
  priority         String    @default("normal")        // "low" | "normal" | "high" | "critical"
  status           String    @default("pending")       // "pending" | "approved" | "rejected" | "expired"
  agentId          String    @map("agent_id")
  traceId          String    @map("trace_id")
  aiRecommendation String?   @map("ai_recommendation") @db.Text
  aiReasoning      String?   @map("ai_reasoning")      @db.Text
  aiConfidence     Float?    @map("ai_confidence")
  /// Serialized tool call to execute on approval — { name, input } shape.
  pendingAction    Json?     @map("pending_action")
  approverUserIds  String[]  @map("approver_user_ids")
  approverRoles    String[]  @map("approver_roles")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  rejectedBy       String?   @map("rejected_by")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  expiresAt        DateTime? @map("expires_at")
  relatedDocType   String?   @map("related_doc_type")
  relatedDocId     String?   @map("related_doc_id")
  createdAt        DateTime  @default(now())          @map("created_at")
  updatedAt        DateTime  @updatedAt               @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status, createdAt])
  @@index([accountId, approvalType, status])
  @@map("cortex_approval_requests")
}

/// Per-tenant learning store. Captures business rules, recurring patterns,
/// user preferences, and corrections so the system gets smarter over time.
/// Confidence is reinforced on each repeat observation; entries with low
/// confidence or that pass `expiresAt` are purged by the cleanup worker.
model CortexMemory {
  id                 String    @id @default(cuid())
  accountId          String    @map("account_id")
  memoryType         String    @map("memory_type")  // "business_rule" | "pattern" | "preference" | "correction" | "threshold"
  key                String
  value              Json
  confidence         Float     @default(0.5)
  learnedFromEvents  String[]  @map("learned_from_events")
  learnedAt          DateTime  @default(now())     @map("learned_at")
  lastReinforcedAt   DateTime? @map("last_reinforced_at")
  reinforcementCount Int       @default(1)         @map("reinforcement_count")
  isActive           Boolean   @default(true)      @map("is_active")
  expiresAt          DateTime? @map("expires_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, memoryType, key])
  @@index([accountId, memoryType])
  @@index([accountId, isActive])
  @@map("cortex_memory")
}

/// Human feedback on Cortex agent decisions. Captures thumbs-up/down ratings,
/// free-text comments, and explicit corrections so the system can (a) measure
/// per-agent satisfaction and (b) feed corrections back into the CortexMemory
/// learning store. Linked by traceId so a feedback row always points at the
/// exact agent run it is grading.
model CortexFeedback {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  agentId         String   @map("agent_id")
  traceId         String   @map("trace_id")
  /// The original AI output the user is grading. Stored as Json so we can
  /// preserve tool call shapes alongside textual replies.
  originalOutput  Json     @map("original_output")
  /// "thumbs_up" | "thumbs_down" | "correction" | "rating"
  feedbackType    String   @map("feedback_type")
  /// User-supplied corrected output, when feedbackType is "correction".
  /// Drives the memory learning pipeline that promotes corrections into
  /// per-tenant business rules over time.
  correctedOutput Json?    @map("corrected_output")
  rating          Int? // 1-5 scale, present when feedbackType is "rating"
  comment         String?  @db.Text
  userId          String   @map("user_id")
  /// Set once the feedback has been used to update CortexMemory; used by the
  /// learning worker to skip already-processed rows.
  appliedToMemory Boolean  @default(false) @map("applied_to_memory")
  memoryId        String?  @map("memory_id")
  createdAt       DateTime @default(now())         @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, agentId, createdAt])
  @@index([accountId, feedbackType])
  @@index([traceId])
  @@map("cortex_feedback")
}
