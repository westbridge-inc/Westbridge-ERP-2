# ═══════════════════════════════════════════════════════════
# Westbridge Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in values.
# Generate secrets: openssl rand -hex 32

# ─── Database ─────────────────────────────────────────────
# Runtime queries connect as the `westbridge_app` role, which is subject
# to Row-Level Security policies (see prisma/migrations/*_rls). To
# provision the role locally, run: ./scripts/provision-rls-role.sh
DATABASE_URL="postgresql://westbridge_app:CHANGEME@localhost:5432/westbridge?schema=public&connection_limit=10"

# Migrations and DDL run as the schema-owning role (not RLS-enforced).
# Prisma's migrate/db push commands automatically prefer this URL via the
# `directUrl` field in prisma/schema.prisma. Leave unset only in development
# where you have run db push as a superuser already.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/westbridge?schema=public"

# ─── Docker Compose (local dev only) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ─── Security (REQUIRED — generate with: openssl rand -hex 32) ─
SESSION_SECRET="change-me-in-production"
CSRF_SECRET="change-me-in-production"
ENCRYPTION_KEY="change-me-in-production"

# Key rotation (set previous key here when rotating)
CSRF_SECRET_PREVIOUS=""
ENCRYPTION_KEY_PREVIOUS=""

# ─── ERPNext Cloud ───────────────────────────────────────
# Sign up at https://erpnext.com — no self-hosting needed.
# Generate API keys: ERPNext > User Settings > API Access
ERPNEXT_URL="https://yoursite.erpnext.com"
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@westbridgetoday.com"

# ─── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Billing (Paddle — Merchant of Record) ───────────────
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_SANDBOX="true"
PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_SOLO=""
PADDLE_PRICE_STARTER=""
PADDLE_PRICE_BUSINESS=""
PADDLE_PRICE_ENTERPRISE=""

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST=""
LOG_LEVEL=info

# ─── Caribbean Defaults (baked into code) ─────────────────
# DEFAULT_CURRENCY=GYD
# VAT_RATE=0.14
# NIS_EMPLOYER_RATE=0.088
# NIS_EMPLOYEE_RATE=0.056
# NIS_CEILING=280000
# PAYE_THRESHOLD=780000
# WITHHOLDING_TAX_RATE=0.20
