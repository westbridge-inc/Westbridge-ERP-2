# ═══════════════════════════════════════════════════════════
# Westbridge Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in values.
# Generate secrets: openssl rand -hex 32

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/westbridge?schema=public"

# ─── Docker Compose (local dev only) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ─── Security (REQUIRED — generate with: openssl rand -hex 32) ─
SESSION_SECRET="change-me-in-production"
CSRF_SECRET="change-me-in-production"
ENCRYPTION_KEY="change-me-in-production"

# Key rotation (set previous key here when rotating)
CSRF_SECRET_PREVIOUS=""
ENCRYPTION_KEY_PREVIOUS=""

# ─── ERPNext Cloud ───────────────────────────────────────
# Sign up at https://erpnext.com — no self-hosting needed.
# Generate API keys: ERPNext > User Settings > API Access
ERPNEXT_URL="https://yoursite.erpnext.com"
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@westbridge.gy"

# ─── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Billing (2Checkout / Verifone) ──────────────────────
TWOCHECKOUT_MERCHANT_CODE=
TWOCHECKOUT_SECRET_KEY=
TWOCHECKOUT_TEST_MODE=true

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST=""
LOG_LEVEL=info

# ─── Caribbean Defaults (baked into code) ─────────────────
# DEFAULT_CURRENCY=GYD
# VAT_RATE=0.14
# NIS_EMPLOYER_RATE=0.088
# NIS_EMPLOYEE_RATE=0.056
# NIS_CEILING=280000
# PAYE_THRESHOLD=780000
# WITHHOLDING_TAX_RATE=0.20
